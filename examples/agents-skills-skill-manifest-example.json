{
  "manifest_version": "0.1",
  "name": "ngrok Agent Skills",
  "provider": "ngrok",
  "homepage": "https://ngrok.com",
  "repository": "https://github.com/ngrok/agent-skills",
  "runtimes": ["claude-code", "claude-agent-sdk"],
  "skills": [
    {
      "name": "ngrok-create-tunnel",
      "path": "skills/create-tunnel",
      "description": "Create an ephemeral ngrok tunnel and return its public URL.",
      "version": "0.3.1"
    },
    {
      "name": "ngrok-list-tunnels",
      "path": "skills/list-tunnels",
      "description": "List active ngrok tunnels for the configured account.",
      "version": "0.3.0"
    },
    {
      "name": "ngrok-rotate-token",
      "path": "skills/rotate-token",
      "description": "Rotate the ngrok auth token used by the agent runtime.",
      "version": "0.2.0"
    }
  ],
  "policies": {
    "signing_required": true,
    "allow_network_calls": true,
    "secrets_required": ["NGROK_AUTH_TOKEN"]
  },
  "maintainers": [
    {
      "name": "ngrok DevRel",
      "email": "devrel@ngrok.com"
    }
  ],
  "tags": ["networking", "tunneling", "developer-tools"]
}
